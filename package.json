{
  "name": "vault-diary",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fake": "VITE_FAKE_DRIVE=true vite",
    "build": "tsc -b && vite build && node scripts/build-recovery.mjs --copy-to dist",
    "build:recovery": "node scripts/build-recovery.mjs",
    "build:e2e": "VITE_FAKE_DRIVE=true vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --port 4174 --strictPort",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:py": "python3 -m unittest discover -s recovery -p 'test_*.py' -v",
    "fixture": "vitest run --config vitest.fixture.config.ts",
    "test:e2e": "node e2e/recovery.e2e.mjs && node e2e/app.e2e.mjs && node e2e/passkey.e2e.mjs && node e2e/media.e2e.mjs && node e2e/insights.e2e.mjs && node e2e/templates.e2e.mjs && node e2e/extras.e2e.mjs && node e2e/stream.e2e.mjs && node e2e/heic.e2e.mjs && node e2e/drill.e2e.mjs && node e2e/location.e2e.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "hash-wasm": "^4.12.0",
    "marked": "^18.1.2",
    "minisearch": "7.2.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "^7.4.1"
  }
}
